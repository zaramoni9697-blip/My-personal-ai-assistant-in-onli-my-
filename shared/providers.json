{
  "$comment": "Canonical AI provider registry. Single source of truth shared by the Android client (assets/providers.json) and the Web backend (web/server/src/providers/registry.js). Keep in sync with docs/API_PROVIDERS.md.",
  "version": 1,
  "creator": "Md Foysal",
  "appName": "JARVIS AI",
  "providers": [
    {
      "id": "gemini",
      "label": "Google Gemini",
      "description": "Google Generative Language API. Supports multimodal (image) input.",
      "requestStyle": "gemini",
      "defaultBaseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "defaultChatPath": "/models/{model}:generateContent",
      "defaultTestPath": "/models/{model}",
      "authType": "header",
      "apiKeyHeader": "x-goog-api-key",
      "apiKeyQueryParam": null,
      "defaultModel": "gemini-2.0-flash",
      "suggestedModels": ["gemini-2.0-flash", "gemini-2.0-flash-lite", "gemini-1.5-flash", "gemini-1.5-pro"],
      "supportsStreaming": true,
      "supportsImages": true,
      "extraHeaders": {}
    },
    {
      "id": "openai",
      "label": "OpenAI",
      "description": "OpenAI Chat Completions API (GPT family).",
      "requestStyle": "openai",
      "defaultBaseUrl": "https://api.openai.com/v1",
      "defaultChatPath": "/chat/completions",
      "defaultTestPath": "/models",
      "authType": "bearer",
      "apiKeyHeader": "Authorization",
      "apiKeyQueryParam": null,
      "defaultModel": "gpt-4o-mini",
      "suggestedModels": ["gpt-4o-mini", "gpt-4o", "gpt-4.1-mini", "gpt-4.1", "o4-mini"],
      "supportsStreaming": true,
      "supportsImages": true,
      "extraHeaders": {}
    },
    {
      "id": "anthropic",
      "label": "Anthropic Claude",
      "description": "Anthropic Messages API (Claude family).",
      "requestStyle": "anthropic",
      "defaultBaseUrl": "https://api.anthropic.com/v1",
      "defaultChatPath": "/messages",
      "defaultTestPath": "/models",
      "authType": "x-api-key",
      "apiKeyHeader": "x-api-key",
      "apiKeyQueryParam": null,
      "defaultModel": "claude-3-5-sonnet-latest",
      "suggestedModels": ["claude-3-5-sonnet-latest", "claude-3-5-haiku-latest", "claude-3-7-sonnet-latest", "claude-sonnet-4-5"],
      "supportsStreaming": true,
      "supportsImages": true,
      "extraHeaders": { "anthropic-version": "2023-06-01" }
    },
    {
      "id": "deepseek",
      "label": "DeepSeek",
      "description": "DeepSeek chat and reasoning models.",
      "requestStyle": "openai",
      "defaultBaseUrl": "https://api.deepseek.com/v1",
      "defaultChatPath": "/chat/completions",
      "defaultTestPath": "/models",
      "authType": "bearer",
      "apiKeyHeader": "Authorization",
      "apiKeyQueryParam": null,
      "defaultModel": "deepseek-chat",
      "suggestedModels": ["deepseek-chat", "deepseek-reasoner"],
      "supportsStreaming": true,
      "supportsImages": false,
      "extraHeaders": {}
    },
    {
      "id": "groq",
      "label": "Groq",
      "description": "Groq LPU inference with OpenAI-compatible API.",
      "requestStyle": "openai",
      "defaultBaseUrl": "https://api.groq.com/openai/v1",
      "defaultChatPath": "/chat/completions",
      "defaultTestPath": "/models",
      "authType": "bearer",
      "apiKeyHeader": "Authorization",
      "apiKeyQueryParam": null,
      "defaultModel": "llama-3.3-70b-versatile",
      "suggestedModels": ["llama-3.3-70b-versatile", "llama-3.1-8b-instant", "gemma2-9b-it", "qwen-qwq-32b"],
      "supportsStreaming": true,
      "supportsImages": false,
      "extraHeaders": {}
    },
    {
      "id": "openrouter",
      "label": "OpenRouter",
      "description": "OpenRouter unified gateway to many models.",
      "requestStyle": "openai",
      "defaultBaseUrl": "https://openrouter.ai/api/v1",
      "defaultChatPath": "/chat/completions",
      "defaultTestPath": "/models",
      "authType": "bearer",
      "apiKeyHeader": "Authorization",
      "apiKeyQueryParam": null,
      "defaultModel": "openai/gpt-4o-mini",
      "suggestedModels": ["openai/gpt-4o-mini", "anthropic/claude-3.5-sonnet", "google/gemini-2.0-flash-001", "meta-llama/llama-3.3-70b-instruct"],
      "supportsStreaming": true,
      "supportsImages": true,
      "extraHeaders": { "HTTP-Referer": "https://jarvis-ai.local", "X-Title": "JARVIS AI" }
    },
    {
      "id": "mistral",
      "label": "Mistral",
      "description": "Mistral AI chat models.",
      "requestStyle": "openai",
      "defaultBaseUrl": "https://api.mistral.ai/v1",
      "defaultChatPath": "/chat/completions",
      "defaultTestPath": "/models",
      "authType": "bearer",
      "apiKeyHeader": "Authorization",
      "apiKeyQueryParam": null,
      "defaultModel": "mistral-small-latest",
      "suggestedModels": ["mistral-small-latest", "mistral-large-latest", "open-mistral-nemo"],
      "supportsStreaming": true,
      "supportsImages": false,
      "extraHeaders": {}
    },
    {
      "id": "custom",
      "label": "Custom API",
      "description": "Any OpenAI-compatible or custom HTTP endpoint. Configure base URL, endpoint path and model yourself.",
      "requestStyle": "openai",
      "defaultBaseUrl": "",
      "defaultChatPath": "/v1/chat/completions",
      "defaultTestPath": "/v1/models",
      "authType": "bearer",
      "apiKeyHeader": "Authorization",
      "apiKeyQueryParam": null,
      "defaultModel": "",
      "suggestedModels": [],
      "supportsStreaming": true,
      "supportsImages": false,
      "customizable": true,
      "extraHeaders": {}
    }
  ]
}
